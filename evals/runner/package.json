{
  "name": "@novagait/evals-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "cassettes:record": "vitest run --config src/cassettes/vitest.scripts.config.ts record.script",
    "cassettes:check": "vitest run --config src/cassettes/vitest.scripts.config.ts check.script",
    "cassettes:replay": "vitest run --config src/cassettes/vitest.scripts.config.ts replay.script",
    "cassettes:baseline": "vitest run --config src/cassettes/vitest.scripts.config.ts baseline.script",
    "spend:prefix": "vitest run --config src/spend/vitest.scripts.config.ts prefix.script",
    "matrix:run": "vitest run --config src/matrix/vitest.scripts.config.ts run.script",
    "matrix:augment": "vitest run --config src/matrix/vitest.scripts.config.ts augment.script",
    "matrix:backfill-routes": "vitest run --config src/matrix/vitest.scripts.config.ts backfill-routes.script",
    "matrix:probe": "vitest run --config src/matrix/vitest.scripts.config.ts probe.script"
  },
  "dependencies": {
    "@novagait/agent": "*",
    "@novagait/mock-backend": "*",
    "@novagait/pipeline": "*"
  }
}
